# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key: server-side only, bypasses RLS. Never expose to the frontend.
SUPABASE_SERVICE_KEY=sb_secret_xxx
SUPABASE_ANON_KEY=sb_publishable_xxx
# Public bucket for surplus-log photos.
SUPABASE_STORAGE_BUCKET=surplus-photos
# Private bucket for payment screenshots (created by supabase_migration_002.sql).
SUPABASE_PAYMENT_BUCKET=payment-proofs

# --- Server ---
CORS_ORIGINS=http://localhost:3000
# Required to create an admin account from the signup form.
ADMIN_INVITE_CODE=WL-ADMIN-CHANGEME

# --- QR payment (no gateway — restaurant pays via UPI QR, uploads a screenshot, admin approves) ---
# Absolute URL, or a path on the frontend site (the QR ships in frontend/public/).
QR_CODE_IMAGE_URL=/payment-qr.png
PAYMENT_UPI_ID=your-upi-id@bank
PAYMENT_PAYEE_NAME=Your Name
PLAN_PRICE_BASIC_INR=100
PLAN_PRICE_PRO_INR=200
TRIAL_DAYS=14
SUBSCRIPTION_DAYS=30

# --- AI assistant (Pro plan) — get a key at console.groq.com > API Keys. Server-side only. ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Email-OTP second login step. Needs working Supabase email (Auth > SMTP). Leave false until it does.
LOGIN_OTP_ENABLED=false
